{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // 이 설정이 무엇을 재고 무엇을 재지 않는지, 그리고 각 스위치가 빠졌을 때 무엇이 조용히
  // 통과하는지는 `docs/agents/verification.md`의 "`lint`가 재는 것과 재지 않는 것"이 갖는다.
  // 여기에는 그 문서가 없으면 틀리게 고치기 쉬운 것만 한 줄씩 적는다.

  // "import"가 빠지면 no-cycle이 무음이 된다.
  "plugins": ["import", "typescript", "unicorn", "oxc"],

  // warning은 종료 코드를 0으로 둔다 — 게이트가 되려면 error여야 한다.
  "categories": { "correctness": "error" },

  // 없으면 type-aware 규칙이 조용히 무시된다. `oxlint-tsgolint`가 함께 있어야 돈다.
  "options": { "typeAware": true },

  "rules": {
    // ignoreTypes 기본값(true)은 타입 전용 순환을 전부 놓친다.
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    // no-cycle은 자기 자신 import를 잡지 않는다.
    "import/no-self-import": "error",
    "typescript/no-floating-promises": "error",
    // src/ 밖(스크립트·설정)에도 별칭 철자 규율은 같게 적용한다. 상대경로 금지는 여기 없다 —
    // `scripts/`는 별칭을 해석하지 않으므로 `../src/...`가 소스를 부르는 유일한 길이다.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["~", "~/**", "@@", "@@/**", "~~", "~~/**"],
            "message": "층을 가리키는 별칭은 '@/' 하나만 쓴다 — WXT가 정의하는 나머지 철자(~, @@, ~~)로 쓰면 위 규칙을 그대로 지나간다"
          }
        ]
      }
    ]
  },

  // 레이어 방향: core → runtime → platform → ui → features → app → entrypoints. 뒤가 앞을 import하고 그 반대는 없다.
  // 층마다 세 그룹이다 — 상향 별칭, 상대경로, 별칭 철자(entrypoints는 위가 없어 둘).
  // 겹치는 override는 규칙을 병합하지 않고 **덮어쓰므로**(실측) 뒤 둘을 위 전역 규칙에서
  // 물려받을 수 없다. 한 줄이 빠져도 설정은 조용히 통과한다 — 그것을 닫는 것은
  // `scripts/oxlint-config.test.mjs`다.
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/runtime",
                  "@/runtime/**",
                  "@/platform",
                  "@/platform/**",
                  "@/ui",
                  "@/ui/**",
                  "@/features",
                  "@/features/**",
                  "@/app",
                  "@/app/**",
                  "@/entrypoints",
                  "@/entrypoints/**"
                ],
                "message": "레이어 방향 위반: core는 뒤 층을 import할 수 없다 (core → runtime → platform → ui → features → app → entrypoints)"
              },
              {
                "group": ["../**"],
                "message": "src/ 안에서는 상대경로로 디렉터리를 거슬러 올라가지 않는다 — 같은 층 안은 './', 층 사이는 '@/<층>/'. 거슬러 올라가는 길이 위 규칙을 지나간다"
              },
              {
                "group": ["~", "~/**", "@@", "@@/**", "~~", "~~/**"],
                "message": "층을 가리키는 별칭은 '@/' 하나만 쓴다 — WXT가 정의하는 나머지 철자(~, @@, ~~)로 쓰면 위 규칙을 그대로 지나간다"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/runtime/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/platform",
                  "@/platform/**",
                  "@/ui",
                  "@/ui/**",
                  "@/features",
                  "@/features/**",
                  "@/app",
                  "@/app/**",
                  "@/entrypoints",
                  "@/entrypoints/**"
                ],
                "message": "레이어 방향 위반: runtime는 뒤 층을 import할 수 없다"
              },
              {
                "group": ["../**"],
                "message": "src/ 안에서는 상대경로로 디렉터리를 거슬러 올라가지 않는다 — 같은 층 안은 './', 층 사이는 '@/<층>/'. 거슬러 올라가는 길이 위 규칙을 지나간다"
              },
              {
                "group": ["~", "~/**", "@@", "@@/**", "~~", "~~/**"],
                "message": "층을 가리키는 별칭은 '@/' 하나만 쓴다 — WXT가 정의하는 나머지 철자(~, @@, ~~)로 쓰면 위 규칙을 그대로 지나간다"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/platform/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/ui",
                  "@/ui/**",
                  "@/features",
                  "@/features/**",
                  "@/app",
                  "@/app/**",
                  "@/entrypoints",
                  "@/entrypoints/**"
                ],
                "message": "레이어 방향 위반: platform는 뒤 층을 import할 수 없다"
              },
              {
                "group": ["../**"],
                "message": "src/ 안에서는 상대경로로 디렉터리를 거슬러 올라가지 않는다 — 같은 층 안은 './', 층 사이는 '@/<층>/'. 거슬러 올라가는 길이 위 규칙을 지나간다"
              },
              {
                "group": ["~", "~/**", "@@", "@@/**", "~~", "~~/**"],
                "message": "층을 가리키는 별칭은 '@/' 하나만 쓴다 — WXT가 정의하는 나머지 철자(~, @@, ~~)로 쓰면 위 규칙을 그대로 지나간다"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features",
                  "@/features/**",
                  "@/app",
                  "@/app/**",
                  "@/entrypoints",
                  "@/entrypoints/**"
                ],
                "message": "레이어 방향 위반: ui는 뒤 층을 import할 수 없다"
              },
              {
                "group": ["../**"],
                "message": "src/ 안에서는 상대경로로 디렉터리를 거슬러 올라가지 않는다 — 같은 층 안은 './', 층 사이는 '@/<층>/'. 거슬러 올라가는 길이 위 규칙을 지나간다"
              },
              {
                "group": ["~", "~/**", "@@", "@@/**", "~~", "~~/**"],
                "message": "층을 가리키는 별칭은 '@/' 하나만 쓴다 — WXT가 정의하는 나머지 철자(~, @@, ~~)로 쓰면 위 규칙을 그대로 지나간다"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**", "@/entrypoints", "@/entrypoints/**"],
                "message": "레이어 방향 위반: features는 뒤 층을 import할 수 없다"
              },
              {
                "group": ["../**"],
                "message": "src/ 안에서는 상대경로로 디렉터리를 거슬러 올라가지 않는다 — 같은 층 안은 './', 층 사이는 '@/<층>/'. 거슬러 올라가는 길이 위 규칙을 지나간다"
              },
              {
                "group": ["~", "~/**", "@@", "@@/**", "~~", "~~/**"],
                "message": "층을 가리키는 별칭은 '@/' 하나만 쓴다 — WXT가 정의하는 나머지 철자(~, @@, ~~)로 쓰면 위 규칙을 그대로 지나간다"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/entrypoints", "@/entrypoints/**"],
                "message": "레이어 방향 위반: app는 뒤 층을 import할 수 없다"
              },
              {
                "group": ["../**"],
                "message": "src/ 안에서는 상대경로로 디렉터리를 거슬러 올라가지 않는다 — 같은 층 안은 './', 층 사이는 '@/<층>/'. 거슬러 올라가는 길이 위 규칙을 지나간다"
              },
              {
                "group": ["~", "~/**", "@@", "@@/**", "~~", "~~/**"],
                "message": "층을 가리키는 별칭은 '@/' 하나만 쓴다 — WXT가 정의하는 나머지 철자(~, @@, ~~)로 쓰면 위 규칙을 그대로 지나간다"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entrypoints/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**"],
                "message": "src/ 안에서는 상대경로로 디렉터리를 거슬러 올라가지 않는다 — 같은 층 안은 './', 층 사이는 '@/<층>/'. 거슬러 올라가는 길이 위 규칙을 지나간다"
              },
              {
                "group": ["~", "~/**", "@@", "@@/**", "~~", "~~/**"],
                "message": "층을 가리키는 별칭은 '@/' 하나만 쓴다 — WXT가 정의하는 나머지 철자(~, @@, ~~)로 쓰면 위 규칙을 그대로 지나간다"
              }
            ]
          }
        ]
      }
    },

    // 'new' | string 센티널(ADR 0006·0017)이 사는 세 파일. TypeScript가 이 합집합을 string으로
    // 접으므로 규칙의 지적은 옳지만, 고치는 길은 문서를 지우거나 브랜드 타입을 들이는
    // 도메인 결정이다(decisions.md 티켓 04). **전역으로 끄지 않는다** — 다른 곳에 같은 모양이
    // 새로 생기면 그때는 걸려야 한다.
    {
      "files": [
        "src/app/app.tsx",
        "src/features/profiles/profile-section.tsx",
        "src/features/profiles/profile-section.stories.tsx"
      ],
      "rules": { "typescript/no-redundant-type-constituents": "off" }
    },

    // scripts/는 타입 프로그램 밖의 .mjs다 — type-aware 판정이 추론된 any 위에 선다.
    {
      "files": ["scripts/**"],
      "rules": { "typescript/restrict-template-expressions": "off" }
    }
  ]
}
