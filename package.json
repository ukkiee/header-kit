{
  "name": "header-kit",
  "description": "Profile-based HTTP request/response modification extension for Chromium browsers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit",
