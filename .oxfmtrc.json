{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  // 값을 고른 근거(실측 수치)와 무엇을 왜 빼는지는 `docs/agents/verification.md`가 갖는다.
  // 여기에는 그 문서 없이도 틀리게 고치지 않도록 한 줄씩만 적는다.

  // 이 코드가 쓰여 온 폭. 다른 값으로 바꾸면 도입 커밋과 무관한 재배치가 생긴다.
  "printWidth": 110,
  "singleQuote": true,
  // 아래 셋은 기본값과 같지만 **적어 둔다** — 도구의 기본값이 바뀌면 게이트가 조용히 다른
  // 것을 요구하게 된다. 버전을 정확히 고정한 이유와 같다.
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",

  // 끈 채로 시작한다. 켜는 것은 시각 게이트를 확인한 뒤 별도 슬라이스다.
  "sortTailwindcss": false,

  // 포매터는 **코드만** 갖는다 — 산문과 기록물은 포매터의 것이 아니다.
  "ignorePatterns": ["**/*.md", "docs/reviews/**", ".scratch/**"]
}
