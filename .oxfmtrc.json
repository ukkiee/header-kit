{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  // 실측으로 고른 값이다. 이 저장소의 기존 코드를 그대로 두고 재보니 바뀌는 줄이
  // 80에서 7641, 100에서 3409, **110에서 3113**, 120에서 3501이었다 — 110이 최소이고,
  // 그것은 이 코드가 그 폭으로 쓰여 왔다는 뜻이다. 포매터를 들이는 커밋이 코드의 모양을
  // 필요 이상으로 흔들지 않게 한다.
  "printWidth": 110,
  // 끄면 3113줄이 12007줄이 된다 — 이 저장소는 작은따옴표를 쓴다.
  "singleQuote": true,
  // 아래 셋은 기본값과 같지만 **적어 둔다.** 버전을 정확히 고정한 이유와 같다: 도구의
  // 기본값이 마이너 사이에 바뀌면 포맷 게이트가 조용히 다른 것을 요구하게 된다.
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",

  // **끈 채로 시작한다.** 켜면 클래스 순서가 전부 바뀌어 이 커밋의 diff가 더 커지고,
  // `cn()` 병합 순서에 기대는 스타일이 있으면 시각적 회귀가 난다. 이 저장소는 시각 계약을
  // 실제 브라우저 검사로 재므로, 켜는 것은 그 게이트들이 초록임을 확인한 뒤 별도 슬라이스다.
  "sortTailwindcss": false,

  // 포매터는 **코드만** 갖는다.
  //   - 마크다운은 사람이 뜻을 담아 줄을 끊은 산문이다(이 저장소의 문서는 손으로 감쌌다).
  //   - `docs/reviews/`의 JSON은 리뷰어가 낸 **기록**이다. 포매터가 왔다는 이유로 증거의
  //     바이트가 바뀌어서는 안 된다. 실측으로 둘이 대상에 들어 있었다.
  //   - `.scratch/`는 이슈 트래커다.
  "ignorePatterns": ["**/*.md", "docs/reviews/**", ".scratch/**"]
}
